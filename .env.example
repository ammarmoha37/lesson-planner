# Anthropic API key for Claude lesson plan generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase project URL (same as supabaseUrl in src/environments/environment.ts)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon key (client-side; copy to environment.ts)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase service role key (server-side only — never expose in frontend)
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY

# Production site URL for CORS (optional for local dev)
SITE_URL=https://your-site.netlify.app
